# Copy to ../.env.local or demo/.env.local (Vite envDir includes the package root).
# Backend origin (no trailing slash). Required for AI replies in the demo.
VITE_API_URL=http://localhost:8000

# Full project JWT from Admin → Projects (`projectToken` in API). Must be THREE dot-separated parts
# (header.payload.signature). If you only paste the first chunk you will get "jwt malformed" on /chat.
# Optional — leave empty for FAQ-only demo.
VITE_PROJECT_TOKEN=
